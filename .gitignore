# Real credential and repo config — see development/03_SECURITY.md.
.env
config/repos.yaml

# Generated by scripts/render-compose.py — see config/repos.yaml.
compose.generated.yaml

# Native macOS runner state: launchd plists, logs, downloaded archives, and
# one-job runner directories. This stays local for the same reason as .env.
.runner-macos/

# Native Windows runner state: Scheduled Task XML, logs, downloaded archives,
# and one-job runner directories. This stays local for the same reason as .env.
.runner-windows/

__pycache__/
*.pyc
